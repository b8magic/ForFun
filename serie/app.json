{
  "expo": {
    "name": "Serie",
    "slug": "serie",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.serie.ios",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "it"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F2E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F2E9",
          "dark": {
            "backgroundColor": "#0C0B09",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "it"
            ]
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-maps",
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SerieDisplay-Black.ttf",
            "./assets/fonts/SerieDisplay-Condensed.ttf",
            "./assets/fonts/SerieDisplay-CondensedMedium.ttf",
            "./assets/fonts/SerieDisplay-Narrow.ttf",
            "./assets/fonts/SerieDisplay-Wide.ttf",
            "./assets/fonts/SerieMono-Medium.ttf",
            "./assets/fonts/SerieMono-Regular.ttf",
            "./assets/fonts/SerieText-Bold.ttf",
            "./assets/fonts/SerieText-Light.ttf",
            "./assets/fonts/SerieText-Medium.ttf",
            "./assets/fonts/SerieText-Regular.ttf"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Serie legge i calendari che scegli per importare le sessioni e controllare i doppioni prima di esportare. Scrive solo gli eventi che confermi.",
          "remindersPermission": false
        }
      ],
      "expo-system-ui",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ]
    ],
    "scheme": "serie",
    "backgroundColor": "#F6F2E9",
    "experiments": {
      "typedRoutes": false
    }
  }
}
